{
  "name": "gonestly-docs",
  "version": "0.0.0",
  "scripts": {
    "content": "node scripts/content/build.mjs",
    "start": "node scripts/dev.mjs",
    "build": "npm run content && node scripts/build.mjs",
    "test": "npm run content && node --test 'scripts/**/*.test.mjs' && ng test --watch=false",
    "lint": "npm run content && ng lint && prettier --check .",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/mulish": "5.3.0",
    "@ngx-translate/core": "18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "2.1.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "marked": "18.3.0",
    "prettier": "^3.8.1",
    "shiki": "4.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  }
}
